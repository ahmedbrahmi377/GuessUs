<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Celebratory gradient - warm tones -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="225"
                android:startColor="#FFF9E6"
                android:centerColor="#FFFBF0"
                android:endColor="#F5F0FF" />
        </shape>
    </item>

    <!-- Victory accent - gold-ish -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFD700" />
            <size android:height="5dp" />
        </shape>
    </item>

    <!-- Celebratory circles - top -->
    <item
        android:top="10%"
        android:left="10%">
        <shape android:shape="oval">
            <solid android:color="#FFE4A3" />
            <size android:width="80dp" android:height="80dp" />
        </shape>
    </item>

    <item
        android:top="15%"
        android:right="15%">
        <shape android:shape="oval">
            <solid android:color="#FED8B1" />
            <size android:width="100dp" android:height="100dp" />
        </shape>
    </item>

    <!-- Purple accents -->
    <item
        android:bottom="20%"
        android:left="5%">
        <shape android:shape="oval">
            <solid android:color="#E8DCFF" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>

    <item
        android:bottom="10%"
        android:right="10%">
        <shape android:shape="oval">
            <solid android:color="#D9CCFF" />
            <size android:width="90dp" android:height="90dp" />
        </shape>
    </item>

    <!-- Center trophy accent -->
    <item
        android:top="45%"
        android:left="40%">
        <shape android:shape="rectangle">
            <solid android:color="#6A55DC" />
            <corners android:radius="30dp" />
            <size android:width="60dp" android:height="60dp" />
        </shape>
    </item>
</layer-list>
