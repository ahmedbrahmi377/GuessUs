<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark base gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#0B0914"
                android:centerColor="#1C172B"
                android:endColor="#2A1F3D" />
        </shape>
    </item>

    <!-- Accent circles - subtle in dark -->
    <item
        android:top="0dp"
        android:right="0dp">
        <shape android:shape="oval">
            <solid android:color="#3D2F52" />
            <size android:width="250dp" android:height="250dp" />
        </shape>
    </item>

    <item
        android:bottom="0dp"
        android:left="0dp">
        <shape android:shape="oval">
            <solid android:color="#251A38" />
            <size android:width="180dp" android:height="180dp" />
        </shape>
    </item>

    <!-- Accent line -->
    <item
        android:top="30%"
        android:left="10%"
        android:right="10%">
        <shape android:shape="rectangle">
            <solid android:color="#8B77E8" />
            <size android:height="2dp" />
        </shape>
    </item>
</layer-list>
