<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#F5F0FF"
                android:endColor="#E8DCFF" />
        </shape>
    </item>

    <!-- Top accent bar -->
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#6A55DC" />
            <size android:height="4dp" />
        </shape>
    </item>

    <!-- Decorative dots pattern -->
    <item
        android:top="20%"
        android:right="5%">
        <shape android:shape="oval">
            <solid android:color="#D9CCFF" />
            <size android:width="40dp" android:height="40dp" />
        </shape>
    </item>

    <item
        android:top="40%"
        android:left="5%">
        <shape android:shape="oval">
            <solid android:color="#E8DCFF" />
            <size android:width="50dp" android:height="50dp" />
        </shape>
    </item>

    <item
        android:bottom="20%"
        android:right="10%">
        <shape android:shape="oval">
            <solid android:color="#F0E6FF" />
            <size android:width="60dp" android:height="60dp" />
        </shape>
    </item>

    <!-- Center gradient circle -->
    <item
        android:top="35%"
        android:right="20%">
        <shape android:shape="oval">
            <solid android:color="#8B77E8" />
            <size android:width="120dp" android:height="120dp" />
        </shape>
    </item>
</layer-list>
